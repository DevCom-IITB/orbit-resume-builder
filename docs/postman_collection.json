{
  "info": {
    "name": "Orbit Resume Builder API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Resume",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{rb_host}}/api/resumes/", "host": ["{{rb_host}}"], "path": ["api","resumes",""] },
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"My Resume\",\n  \"resume_type\": \"ONE\",\n  \"header_type\": \"SHORT\"\n}" }
      }
    },
    {
      "name": "List Resumes",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{rb_host}}/api/resumes/", "host": ["{{rb_host}}"], "path": ["api","resumes",""] }
      }
    }
  ]
}
