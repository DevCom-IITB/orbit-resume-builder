# =========================
# Database
# =========================
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# =========================
# Django
# =========================
DJANGO_DEBUG=True
DJANGO_SECRET_KEY="replace_me_with_a_secure_key"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =========================
# Frontend / CORS
# =========================
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# Reach auth integration
# =========================
REACH_VERIFY_URL=http://127.0.0.1:8000/api/sso/accounts/verify/
RB_SERVICE_KEY=dev-resume-key-1

# =========================
# LLM provider toggle
# =========================
# Selects which LLM backend the server talks to. One value, one place.
# Accepted values: truefoundry | bharatcode | google
LLM_PROVIDER=truefoundry

# =========================
# LLM — TrueFoundry / Prodigal  [used when LLM_PROVIDER=truefoundry]
# =========================
# LLM_API_KEY=your-truefoundry-api-key-here
# LLM_BASE_URL=your-truefoundry-base-url-here
# LLM_MODEL=prodigal-groq/gpt-oss-120b

# =========================
# LLM — BharatCode  [used when LLM_PROVIDER=bharatcode]
# =========================
# BHARATCODE_API_KEY=your-bharatcode-api-key-here
# BHARATCODE_ENDPOINT=https://bharatcode.ai/api/model/v1/chat/completions
# BHARATCODE_MODEL=bharatcode:qwen36-35b-awq-200k

# =========================
# LLM — Google AI Studio  [used when LLM_PROVIDER=google]
# Get your key at https://aistudio.google.com/apikey
# =========================
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_MODEL=gemini-2.0-flash