# =========================
# Database
# =========================
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# ==============================
# Chroma DB
# ==============================
CHROMA_DB_PATH=your chroma db path 
CHROMA_COLLECTION_NAME=name of the chroma db container

# =========================
# Django
# =========================
DJANGO_DEBUG=True
DJANGO_SECRET_KEY="replace_me_with_a_secure_key"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =========================
# Frontend / CORS
# =========================
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# Reach auth integration
# =========================
REACH_VERIFY_URL=http://127.0.0.1:8000/api/sso/accounts/verify/
# Shared secret with REACH. Required when DJANGO_DEBUG=False (an unset key
# fails closed); with DEBUG the dev value below is used if unset.
RB_SERVICE_KEY=dev-resume-key-1
# Origins of the REACH app that embeds Orbit (comma-separated). The SSO
# callback only posts the token to these. Defaults to http://localhost:3000
# with DEBUG.
REACH_ORIGINS=http://localhost:3000

# =========================
# LLM (Google Gemini)
# =========================
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.8-flash

# =========================
# GitHub project import (optional)
# =========================
# Leave unset to disable the GitHub endpoints (they return 503).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/resume-renderer/github/callback/
# "read:user" can only import public repos. "repo read:user" allows private
# repos but also grants write access to them.
# GITHUB_OAUTH_SCOPE=read:user

#Hugging Face Token for SentenceTransformer and CrossEncoder models==================
HF_TOKEN=your hugging face access token here
