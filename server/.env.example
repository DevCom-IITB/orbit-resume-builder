# =========================
# Database
# =========================
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# ==============================
# Chroma DB
# ==============================
CHROMA_DB_PATH=your chroma db path 
CHROMA_COLLECTION_NAME=name of the chroma db container

# =========================
# Django
# =========================
DJANGO_DEBUG=True
DJANGO_SECRET_KEY="replace_me_with_a_secure_key"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =========================
# Frontend / CORS
# =========================
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# Reach auth integration
# =========================
REACH_VERIFY_URL=http://127.0.0.1:8000/api/sso/accounts/verify/
RB_SERVICE_KEY=dev-resume-key-1

# =========================
# LLM provider toggle
# =========================
# Selects which LLM backend the server talks to. One value, one place.
# Accepted values: truefoundry | bharatcode | google
LLM_PROVIDER=google

# =========================
# LLM — TrueFoundry / Prodigal  [used when LLM_PROVIDER=truefoundry]
# =========================
# LLM_API_KEY=your-truefoundry-api-key-here
# LLM_BASE_URL=your-truefoundry-base-url-here
# LLM_MODEL=prodigal-groq/gpt-oss-120b

# =========================
# LLM — BharatCode  [used when LLM_PROVIDER=bharatcode]
# =========================
# BHARATCODE_API_KEY=your-bharatcode-api-key-here
# BHARATCODE_ENDPOINT=https://bharatcode.ai/api/model/v1/chat/completions
# BHARATCODE_MODEL=bharatcode:qwen36-35b-awq-200k

# =========================
# LLM — Google AI Studio  [used when LLM_PROVIDER=google]
# Get your key at https://aistudio.google.com/apikey
# =========================
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_MODEL=gemini-2.0-flash

# Hugging Face Token for SentenceTransformer and CrossEncoder models
HF_TOKEN=your hugging face access token here

# Inclusive final-line fill targets for one- or two-line bullets in the selected layout.
BULLET_FIT_MIN_RATIO=0.88
BULLET_FIT_MAX_RATIO=1.00
BULLET_FIT_MODEL_BATCH_SIZE=3
# 0 means no hard cap; a positive limit prevents splitting past that bullet count.
BULLET_FIT_MAX_BULLETS_PER_ITEM=0

# Optional experiment: one cached Lite extraction call before main generation.
# Uses the SAME API key and endpoint as the main Gemini model.
# This switch is independent of optimizer retries (ITERATION_CALLS).
RESUME_LLM_LITE_PREPROCESSING=false
# Model used for Lite preprocessing assist calls (e.g. gemini-2.0-flash or gemini-1.5-flash)
# ASSIST_MODEL=gemini-2.0-flash

# Optimizer retries PER BATCH, after its initial request. Default: one retry.
# 0 = at most 1 call; 1 = at most 2 calls; 2 = at most 3 calls, etc.
# Resolved content stops early. Failures and malformed responses consume a call.
ITERATION_CALLS=1
