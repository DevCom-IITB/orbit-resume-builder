# =========================
# Database
# =========================
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# ==============================
# Chroma DB
# ==============================
CHROMA_DB_PATH=your chroma db path 
CHROMA_COLLECTION_NAME=name of the chroma db container

# =========================
# Django
# =========================
DJANGO_DEBUG=True
DJANGO_SECRET_KEY="replace_me_with_a_secure_key"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =========================
# Frontend / CORS
# =========================
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# Reach auth integration
# =========================
REACH_VERIFY_URL=http://127.0.0.1:8000/api/sso/accounts/verify/
# Shared secret with REACH. Required when DJANGO_DEBUG=False (an unset key
# fails closed); with DEBUG the dev value below is used if unset.
RB_SERVICE_KEY=dev-resume-key-1
# Origins of the REACH app that embeds Orbit (comma-separated). The SSO
# callback only posts the token to these. Defaults to http://localhost:3000
# with DEBUG.
REACH_ORIGINS=http://localhost:3000

# =========================
# LLM (Google Gemini)
# =========================
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_MODEL=gemini-3.8-flash
# GEMINI_MODEL is also accepted when GOOGLE_MODEL is unset.

# =========================
# GitHub project import (optional)
# =========================
# Leave unset to disable the GitHub endpoints (they return 503).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/resume-renderer/github/callback/
# "read:user" can only import public repos. "repo read:user" allows private
# repos but also grants write access to them.
# GITHUB_OAUTH_SCOPE=read:user

# Hugging Face Token for SentenceTransformer and CrossEncoder models
HF_TOKEN=your hugging face access token here

# =========================
# Redis & LLM Rate Limiting / Security
# =========================
REDIS_URL=redis://localhost:6379/0

# LLM usage limits
ORBIT_LLM_USER_30MIN_LIMIT=20
ORBIT_LLM_USER_30MIN_WINDOW_SECONDS=1800
ORBIT_LLM_USER_DAILY_LIMIT=100
ORBIT_LLM_USER_DAILY_WINDOW_SECONDS=86400

# Abuse restrictions escalation (seconds)
ORBIT_ABUSE_FIRST_BLOCK_SECONDS=600
ORBIT_ABUSE_SECOND_BLOCK_SECONDS=3600
ORBIT_ABUSE_THIRD_BLOCK_SECONDS=86400

# Inclusive final-line fill targets for one- or two-line bullets in the selected layout.
BULLET_FIT_MIN_RATIO=0.88
BULLET_FIT_MAX_RATIO=1.00
BULLET_FIT_MODEL_BATCH_SIZE=3
# 0 means no hard cap; a positive limit prevents splitting past that bullet count.
BULLET_FIT_MAX_BULLETS_PER_ITEM=0

# Optional experiment: one cached Lite extraction call before main generation.
# Uses the SAME API key and endpoint as the main Gemini model.
# This switch is independent of optimizer retries (ITERATION_CALLS).
RESUME_LLM_LITE_PREPROCESSING=false
# Model used for Lite preprocessing assist calls (e.g. gemini-2.0-flash or gemini-1.5-flash)
# ASSIST_MODEL=gemini-2.0-flash

# Optimizer retries PER BATCH, after its initial request. Default: one retry.
# 0 = at most 1 call; 1 = at most 2 calls; 2 = at most 3 calls, etc.
# Resolved content stops early. Failures and malformed responses consume a call.
ITERATION_CALLS=1
